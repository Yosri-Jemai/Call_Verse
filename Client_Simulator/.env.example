# Database
# Set your own credentials in Client_Simulator/.env
# Or leave DATABASE_URL unset to use SQLite if supported.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/client_sim

# LLM providers: add your own key in .env, never commit real keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Groq models
# GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Gemini
# GEMINI_MODEL=gemini-2.5-flash

# Ollama (local)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Darija / Tunisian Arabizi
# DARIJA_LLM=derja
# DARIJA_MODEL=gemini-2.5-pro
# DERJA_BASE_URL=http://localhost:8009/v1
# DERJA_SERVED_MODEL=ESPRIT-Derja-Qwen3-8B-v2
# DERJA_API_KEY=
# DERJA_4BIT=1

# Voice
# WHISPER_MODEL=small