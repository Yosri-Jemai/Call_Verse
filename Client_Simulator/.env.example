# --- Darija (Tunisian Arabizi) ---------------------------------------------------------------
# A dedicated model writes ONLY the Darija lines (small models answer in French / MSA instead).
# Leave empty = automatic: gemini (2.5-pro) > claude > groq > ollama, whichever key is set.
# DARIJA_LLM=derja         # derja | derja_hf | gemini | claude | groq | ollama
# DARIJA_MODEL=gemini-2.5-pro

# --- ESPRIT-Derja-Qwen3-8B-v2 (Tunisian Darija model, Hugging Face: ESPRIT-Group/ESPRIT-Derja-Qwen3-8B-v2) ---
# derja     = OpenAI-compatible server (vLLM / Docker / ESPRIT AI Forge). Setting DERJA_BASE_URL makes it the
#             first choice for "Auto".
# derja_hf  = loaded inside this Python process with transformers (needs a GPU; DERJA_4BIT=1 for a small one).
# DERJA_BASE_URL=http://localhost:8009/v1
# DERJA_SERVED_MODEL=ESPRIT-Derja-Qwen3-8B-v2
# DERJA_API_KEY=
# DERJA_4BIT=1

