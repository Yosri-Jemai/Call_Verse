# PostgreSQL (recommended). Create the database first:  createdb client_sim
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/client_sim
# Or leave DATABASE_URL unset to use a local SQLite file (client_simulator.db).

# LLM keys (only the backend you use)
# Put ONE of them here: the file is now loaded automatically (copy .env.example to .env).
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# Ollama needs no key: just run `ollama serve` and `ollama pull llama3.2` (OLLAMA_HOST optional)

