# Never put real API keys in this template. Copy it to .env and fill keys there.

# Application mode
APP_MODE=demo

# Supported providers: openai, anthropic, google, groq, huggingface, free-tier.
LLM_PROVIDER=groq
GROQ_API_KEY=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
MODEL_NAME=openai/gpt-oss-120b
MODEL_MAX_TOKENS=2048

MODEL_TEMPERATURE=0.1
HF_INFERENCE_PROVIDER=together

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cashy-financial-advisor

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cashy_banking
DB_NAME_DEMO=cashy_banking_demo
DB_NAME_PERSONAL=cashy_banking
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=

# Optional Redis cache for bank-policy retrieval results
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_ENABLED=true
REDIS_POLICY_CACHE_TTL_SECONDS=300

# Local multilingual policy embeddings and minimum cosine similarity.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
SIMILARITY_THRESHOLD=0.55

# Local API and application
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
DEBUG=true
CURRENT_CUSTOMER_ID=1
