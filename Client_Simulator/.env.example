DATABASE_URL=postgresql://postgres:yosri@localhost:5432/client_sim

GROQ_API_KEY=
QUALITY_ANALYST_MODEL=openai/gpt-oss-120b
QUALITY_ANALYST_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant
QUALITY_ANALYST_MAX_PROMPT_TOKENS=6500
QUALITY_ANALYST_MAX_COMPLETION_TOKENS=1200
QUALITY_ANALYST_TOOL_RESULT_CHARS=300
QUALITY_ANALYST_POLICY_EXCERPT_CHARS=400
QUALITY_ANALYST_POLICY_PASSES_PER_TURN=2
QUALITY_ANALYST_COMPACT_TRACE_CHARS=150
QUALITY_ANALYST_COMPACT_POLICY_PASSES_PER_TURN=1
# Separate PostgreSQL database for Quality Analyst (leave DATABASE_URL for Client Simulator).
QA_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/quality_analyst
# Optional separate key for Quality Analyst:
# QUALITY_ANALYST_GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile        # lighter/faster: llama-3.1-8b-instant
# Gemini: free key at aistudio.google.com
#GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Ollama: local and offline. Install from ollama.com, then:  ollama pull qwen2.5:7b
 #OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# Claude
# ANTHROPIC_API_KEY=

# ---- Voice ----
# Speech-to-text uses Groq Whisper when GROQ_API_KEY is set, else local faster-whisper.
 GROQ_STT_MODEL=whisper-large-v3-turbo
 #WHISPER_MODEL=small                       # local model size: tiny | base | small | medium
